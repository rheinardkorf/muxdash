#!/usr/bin/env zsh
# Open the muxdash session from anywhere (e.g. a Hammerspoon hotkey), kitty open or not.
#
# Builds or repairs the session (muxdash up -d), then switches the most recently
# used tmux client to it and brings kitty forward; with no tmux client (or no
# kitty), opens a kitty window attached to it. macOS and kitty only.
emulate -L zsh
# launchers start this with a bare PATH: Homebrew (Apple Silicon, Intel) where it exists
path=(/opt/homebrew/bin(N) /usr/local/bin(N) $path)
typeset -U path

muxdash="${0:A:h}/muxdash"   # beside this file, through any symlink
tmux="$(command -v tmux)" || { print -u2 "muxdash-open: tmux not found"; exit 1 }

$muxdash up -d >/dev/null 2>&1 || { print -u2 "muxdash-open: muxdash up failed"; exit 1 }
client="$(tmux list-clients -F '#{client_activity} #{client_name}' 2>/dev/null | sort -rn | awk 'NR == 1 { print $2 }')"
if [[ -n $client ]] && pgrep -xq kitty; then
  tmux switch-client -c "$client" -t "=muxdash"
  open -a kitty
else
  open -na kitty --args $tmux attach -t "=muxdash"
fi
